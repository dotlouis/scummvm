From c1f61579387927e4bd6d4138f78f9968e2d9c6f3 Mon Sep 17 00:00:00 2001
From: dotlouis <1891109+dotlouis@users.noreply.github.com>
Date: Sat, 10 Oct 2026 03:15:59 -0700
Subject: [PATCH 14/41] MTROPOLIS: Resolve child modifiers of modifiers by name

Modifiers that contain other modifiers, such as behaviors, now expose
them as attributes, so scripts can read and write
"behavior.variable" like they can for the modifiers of an element.

Uncle Albert's Fabulous Voyage reads "draguer_objet.est_objet" to know
whether a notebook object is being dragged.

Assisted-by: Claude:claude-opus-5-5
---
 engines/mtropolis/runtime.cpp | 24 ++++++++++++++++++++++++
 engines/mtropolis/runtime.h   |  1 +
 2 files changed, 25 insertions(+)

diff --git a/engines/mtropolis/runtime.cpp b/engines/mtropolis/runtime.cpp
index b306f08c076..a3a3adebb0a 100644
--- a/engines/mtropolis/runtime.cpp
+++ b/engines/mtropolis/runtime.cpp
@@ -10304,9 +10304,28 @@ bool Modifier::readAttribute(MiniscriptThread *thread, DynamicValue &result, con
 		return true;
 	}
 
+	// Modifiers that contain other modifiers (e.g. behaviors) expose them by name
+	if (Modifier *child = findChildByName(attrib)) {
+		result.setObject(child->getSelfReference());
+		return true;
+	}
+
 	return false;
 }
 
+Modifier *Modifier::findChildByName(const Common::String &name) {
+	IModifierContainer *container = getChildContainer();
+	if (!container)
+		return nullptr;
+
+	for (const Common::SharedPtr<Modifier> &child : container->getModifiers()) {
+		if (caseInsensitiveEqual(child->getName(), name))
+			return child.get();
+	}
+
+	return nullptr;
+}
+
 MiniscriptInstructionOutcome Modifier::writeRefAttribute(MiniscriptThread *thread, DynamicValueWriteProxy &writeProxy, const Common::String &attrib) {
 	if (attrib == "parent") {
 		DynamicValueWriteObjectHelper::create(_parent.lock().get(), writeProxy);
@@ -10316,6 +10335,11 @@ MiniscriptInstructionOutcome Modifier::writeRefAttribute(MiniscriptThread *threa
 		return kMiniscriptInstructionOutcomeContinue;
 	}
 
+	if (Modifier *child = findChildByName(attrib)) {
+		DynamicValueWriteObjectHelper::create(child, writeProxy);
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+
 	return RuntimeObject::writeRefAttribute(thread, writeProxy, attrib);
 }
 
diff --git a/engines/mtropolis/runtime.h b/engines/mtropolis/runtime.h
index 31db9a083ad..8c6a853884c 100644
--- a/engines/mtropolis/runtime.h
+++ b/engines/mtropolis/runtime.h
@@ -3116,6 +3116,7 @@ public:
 	void recursiveCollectObjectsMatchingCriteria(Common::Array<Common::WeakPtr<RuntimeObject> > &results, bool (*evalFunc)(void *userData, RuntimeObject *object), void *userData, bool onlyEnabled);
 
 	Structural *findStructuralOwner() const;
+	Modifier *findChildByName(const Common::String &name);
 
 	void setHooks(const Common::SharedPtr<ModifierHooks> &hooks);
 	const Common::SharedPtr<ModifierHooks> &getHooks() const;
