+			str = value.getBool() ? "true" : "false";
+			break;
+		case DynamicValueTypes::kPoint:
+			str = Common::String::format("(%d,%d)", (int)value.getPoint().x, (int)value.getPoint().y);
+			break;
+		case DynamicValueTypes::kNull:
+			str = "null";
