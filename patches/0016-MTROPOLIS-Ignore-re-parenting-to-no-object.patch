From 6522a045f9880e91340ddc657e860d370b634045 Mon Sep 17 00:00:00 2001
From: dotlouis <1891109+dotlouis@users.noreply.github.com>
Date: Sat, 10 Oct 2026 04:06:59 -0700
Subject: [PATCH 16/41] MTROPOLIS: Ignore re-parenting to no object

Setting "parent" to a null value now does nothing instead of stopping
the script. Uncle Albert's Fabulous Voyage does this for notebook
objects that are restored without a page, and the rest of the script
must still run for the page to finish loading.

Assisted-by: Claude:claude-opus-5-5
---
 engines/mtropolis/runtime.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/engines/mtropolis/runtime.cpp b/engines/mtropolis/runtime.cpp
index a3a3adebb0a..75562f4ae35 100644
--- a/engines/mtropolis/runtime.cpp
+++ b/engines/mtropolis/runtime.cpp
@@ -2905,6 +2905,11 @@ MiniscriptInstructionOutcome RuntimeObject::scriptSetKill(MiniscriptThread *thre
 }
 
 MiniscriptInstructionOutcome RuntimeObject::scriptSetParent(MiniscriptThread *thread, const DynamicValue &value) {
+	// Re-parenting to no object does nothing. Uncle Albert's Fabulous Voyage does this for notebook
+	// objects restored without a page, and relies on the rest of the script running.
+	if (value.getType() == DynamicValueTypes::kNull)
+		return kMiniscriptInstructionOutcomeContinue;
+
 	if (value.getType() != DynamicValueTypes::kObject) {
 		thread->error("Object couldn't be re-parented to a non-object");
 		return kMiniscriptInstructionOutcomeFailed;
