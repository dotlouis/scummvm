From b3bfc0ca5a67b1f92a56001d18036f2b7c994183 Mon Sep 17 00:00:00 2001
From: dotlouis <1891109+dotlouis@users.noreply.github.com>
Date: Sat, 10 Oct 2026 04:07:01 -0700
Subject: [PATCH 19/41] MTROPOLIS: Store the Thereware Rotator angle

Scripts read and write the rotator "angle" to save and restore the
orientation of notebook objects. Store it so that it reads back, even
though rotation itself isn't implemented yet.

Assisted-by: Claude:claude-opus-5-5
---
 engines/mtropolis/plugin/thereware.cpp | 10 +++++++++-
 engines/mtropolis/plugin/thereware.h   |  3 +++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/engines/mtropolis/plugin/thereware.cpp b/engines/mtropolis/plugin/thereware.cpp
index 02afdc19949..4f1e120912b 100644
--- a/engines/mtropolis/plugin/thereware.cpp
+++ b/engines/mtropolis/plugin/thereware.cpp
@@ -26,7 +26,7 @@ namespace MTropolis {
 
 namespace Thereware {
 
-RotatorModifier::RotatorModifier() : _haveSize(false), _sizeX(0), _sizeY(0) {
+RotatorModifier::RotatorModifier() : _haveSize(false), _sizeX(0), _sizeY(0), _angle(0.0) {
 }
 
 RotatorModifier::~RotatorModifier() {
@@ -57,6 +57,10 @@ bool RotatorModifier::readAttribute(MiniscriptThread *thread, DynamicValue &resu
 		result.setPoint(Common::Point(_sizeX, _sizeY));
 		return true;
 	}
+	if (attrib == "angle") {
+		result.setFloat(_angle);
+		return true;
+	}
 
 	return Modifier::readAttribute(thread, result, attrib);
 }
@@ -67,6 +71,10 @@ MiniscriptInstructionOutcome RotatorModifier::writeRefAttribute(MiniscriptThread
 		DynamicValueWriteOrRefAttribFuncHelper<RotatorModifier, &RotatorModifier::scriptSetSize, &RotatorModifier::scriptWriteRefSizeAttribute>::create(this, result);
 		return kMiniscriptInstructionOutcomeContinue;
 	}
+	if (attrib == "angle") {
+		DynamicValueWriteFloatHelper<double>::create(&_angle, result);
+		return kMiniscriptInstructionOutcomeContinue;
+	}
 
 	return Modifier::writeRefAttribute(thread, result, attrib);
 }
diff --git a/engines/mtropolis/plugin/thereware.h b/engines/mtropolis/plugin/thereware.h
index c81b899e70e..f41b13de1d7 100644
--- a/engines/mtropolis/plugin/thereware.h
+++ b/engines/mtropolis/plugin/thereware.h
@@ -107,6 +107,9 @@ private:
 	bool _haveSize;
 	int32 _sizeX;
 	int32 _sizeY;
+
+	// Rotation angle in degrees
+	double _angle;
 };
 
 class TrackerModifier : public Modifier {
