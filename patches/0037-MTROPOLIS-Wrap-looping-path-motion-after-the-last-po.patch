From 7c32743b1e6dc7715a89b6135cd95e62a98316d7 Mon Sep 17 00:00:00 2001
From: dotlouis <1891109+dotlouis@users.noreply.github.com>
Date: Sun, 11 Oct 2026 11:30:16 -0700
Subject: [PATCH 37/41] MTROPOLIS: Wrap looping path motion after the last
 point

A looping path advanced from its last point to index size() instead
of wrapping to 0, then read past the end of the point list. Uncle
Albert's Fabulous Voyage asserts when the ants turn the capstan on
crocodile island.

Assisted-by: Claude:claude-opus-5-5
---
 engines/mtropolis/modifiers.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/engines/mtropolis/modifiers.cpp b/engines/mtropolis/modifiers.cpp
index 77e7d482994..c36de0bfcb8 100644
--- a/engines/mtropolis/modifiers.cpp
+++ b/engines/mtropolis/modifiers.cpp
@@ -1171,7 +1171,7 @@ VThreadState PathMotionModifier::advanceFrameTask(const AdvanceFrameTaskData &ta
 	uint nextPointIndex = 0;
 	if (isPlayingForward) {
 		nextPointIndex = _currentPointIndex + 1;
-		if (nextPointIndex > _points.size())
+		if (nextPointIndex >= _points.size())
 			nextPointIndex = 0;
 	} else {
 		if (_currentPointIndex == 0)
